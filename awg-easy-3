#!/bin/sh
set -eu

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "run this command as root: sudo awg-easy-3"

location_file=/etc/awg-easy-3-install-dir
[ -r "$location_file" ] || die "installation location is unavailable"
IFS= read -r project_dir < "$location_file"
case "$project_dir" in /*) ;; *) die "invalid installation location" ;; esac
[ -f "$project_dir/docker-compose.yml" ] || die "docker-compose.yml not found in $project_dir"
[ -x "$project_dir/install.sh" ] || die "installer not found in $project_dir"
[ -r "$project_dir/lib/auto-update.sh" ] || die "auto-update support is missing from $project_dir"
# shellcheck disable=SC1091
. "$project_dir/lib/auto-update.sh"

main_node_enabled=false
if [ -e "$project_dir/.env.cells-main" ] || [ -L "$project_dir/.env.cells-main" ]; then
  [ -f "$project_dir/.env.cells-main" ] && [ ! -L "$project_dir/.env.cells-main" ] \
    && [ -f "$project_dir/docker-compose.cells-main.yml" ] \
    || die 'Main Node installation record or compose file is unsafe or missing'
  main_node_enabled=true
elif docker container inspect awg-easy-3-main-cell >/dev/null 2>&1; then
  die 'Main Node container exists without its installation record; refusing panel-only management'
fi

compose() {
  if [ "$main_node_enabled" = true ]; then
    docker compose --project-directory "$project_dir" \
      --env-file "$project_dir/.env.cells-main" \
      -f "$project_dir/docker-compose.yml" \
      -f "$project_dir/docker-compose.cells-main.yml" --profile cells-main "$@"
    return
  fi
  docker compose --project-directory "$project_dir" -f "$project_dir/docker-compose.yml" "$@"
}

show_help() {
  cat <<'EOF'
AWG-Easy 3 management commands:

  awg-easy-3                 Open the interactive management menu
  awg-easy-3 start           Start the panel and VPN
  awg-easy-3 stop            Stop the panel and VPN cleanly
  awg-easy-3 restart         Restart the panel and VPN
  awg-easy-3 status          Show container and network status
  awg-easy-3 settings        Show non-secret saved settings
  awg-easy-3 logs            Follow panel logs
  awg-easy-3 diagnose        Show status and recent logs
  awg-easy-3 update          Install the newest stable release safely
  awg-easy-3 auto-update enable|disable|status|run
                              Manage the check performed after OS boot
  awg-easy-3 reset-password  Generate a new panel password
  awg-easy-3 export-client NAME
                              Export an existing client by name or ID
  awg-easy-3 enable-main-node
                              Enable Main Node on this installed panel
  awg-easy-3 issue-cell     Issue one short-lived Cell invitation
  awg-easy-3 uninstall       Remove AWG-Easy 3 and all its settings
  awg-easy-3 reinstall       Reinstall from scratch
  awg-easy-3 help            Show this help
EOF
}

command=${1:-menu}
case "$command" in
  menu) exec "$project_dir/install.sh" ;;
  start)
    if [ "$main_node_enabled" = true ]; then compose up -d awg-easy main-cell
    else compose up -d awg-easy; fi
    ;;
  stop)
    if [ "$main_node_enabled" = true ]; then compose stop main-cell awg-easy
    else compose stop awg-easy; fi
    ;;
  restart)
    if [ "$main_node_enabled" = true ]; then compose restart awg-easy main-cell
    else compose restart awg-easy; fi
    ;;
  status)
    if [ "$main_node_enabled" = true ]; then compose ps awg-easy main-cell
    else compose ps awg-easy; fi
    if ip link show dev awg0 >/dev/null 2>&1; then printf 'AWG interface: active\n'; else printf 'AWG interface: inactive\n'; fi
    if nft list table inet awg_easy_3 >/dev/null 2>&1; then printf 'nftables policy: active\n'; else printf 'nftables policy: inactive\n'; fi
    ;;
  settings)
    # State, not initialization-time environment, is authoritative after updates.
    # One-shot read also works while the VPN container is deliberately stopped.
    compose run --rm --no-deps -T awg-easy settings
    ;;
  logs) compose logs --tail=100 -f awg-easy ;;
  diagnose)
    if [ "$main_node_enabled" = true ]; then compose ps awg-easy main-cell
    else compose ps awg-easy; fi
    printf '\nRecent logs:\n'
    compose logs --tail=50 awg-easy
    ;;
  update)
    awg_easy_run_stable_update
    ;;
  auto-update)
    subcommand=${2:-status}
    case "$subcommand" in
      enable)
        if awg_easy_auto_update_enable; then :; else exit $?; fi
        ;;
      disable) awg_easy_auto_update_disable ;;
      status) awg_easy_auto_update_status ;;
      run) awg_easy_run_stable_update automatic ;;
      *) die "unknown auto-update command: $subcommand (use enable, disable, status or run)" ;;
    esac
    ;;
  reset-password)
    shift
    compose run --rm --no-deps awg-easy reset-password "$@"
    ;;
  export-client)
    [ "$#" -ge 2 ] || die "client name or ID is required"
    compose run --rm --no-deps awg-easy export-client "$2"
    ;;
  enable-main-node) exec "$project_dir/enable-main-node.sh" ;;
  issue-cell)
    [ "$main_node_enabled" = true ] || die 'Main Node is not enabled'
    compose exec -T main-cell node /app/main-cell-cli.js issue-auto
    ;;
  uninstall|--uninstall) exec "$project_dir/install.sh" --uninstall ;;
  reinstall|--reinstall) exec "$project_dir/install.sh" --reinstall ;;
  help|-h|--help) show_help ;;
  *) die "unknown command: $command (run 'sudo awg-easy-3 help')" ;;
esac
